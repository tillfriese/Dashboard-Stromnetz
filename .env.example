# ---------------------------------------------------------------------------
# Netzlage – Umgebungsvariablen. Kopieren nach .env und Werte setzen.
# Secrets erzeugen: siehe README, Abschnitt "Secrets erzeugen".
# ---------------------------------------------------------------------------

# Datenbank-Passwort (wird von db und app genutzt)
POSTGRES_PASSWORD=change-me

# Verbindung zur DB. In docker compose wird sie automatisch aus POSTGRES_PASSWORD gesetzt;
# nur für lokale Entwicklung ohne Compose relevant.
DATABASE_URL=postgres://netzlage:change-me@localhost:5432/netzlage

# Better Auth (Phase 2)
# Zufälliges Secret, mind. 32 Zeichen
BETTER_AUTH_SECRET=
# Öffentliche URL der App. Bestimmt die Passkey-Domain (rpID)!
# Lokal: http://localhost:3000 · Produktion: https://netzlage.example.de
BETTER_AUTH_URL=http://localhost:3000

# Schlüssel zur Verschlüsselung der Einstellungen (AES-256-GCM), 32 Byte als Base64
SETTINGS_ENCRYPTION_KEY=

# true blendet Börsenpreise aus (EPEX-Lizenz bei öffentlichem Betrieb)
PUBLIC_MODE=false

# Fallbacks, falls im Admin-Bereich nichts hinterlegt ist (optional)
ENTSOE_API_TOKEN=
GRIDRADAR_API_TOKEN=
STROMGEDACHT_ZIP=70173

# Nur für das Caddy-Profil (docker compose --profile https up -d)
DOMAIN=netzlage.example.de
ACME_EMAIL=admin@example.de

# Optional: offline GeoIP database (.mmdb, e.g. DB-IP "IP to Country Lite") for the visitor statistics.
# Only the country code is stored, never the IP.
GEOIP_DB_PATH=
